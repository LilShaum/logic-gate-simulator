+  } catch {
+    return false;
+  }
+};
+
+/** Save the working circuit so a refresh does not lose it */
+export const saveAutosave = (doc: CircuitDocument): boolean =>
+  writeKey(AUTOSAVE_KEY, serializeDocument(doc));
