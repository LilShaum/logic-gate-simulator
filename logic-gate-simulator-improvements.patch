+  const raw = readKey(AUTOSAVE_KEY);
+  return raw ? deserializeDocument(raw) : null;
+};
+
+export const clearAutosave = (): void => {
+  try {
+    window.localStorage.removeItem(AUTOSAVE_KEY);
